PORT=8081
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/kds
CORS_ORIGIN=*
AUTH_ENABLED=true
AUTH_USERNAME=cliente
AUTH_PASSWORD=trocar-esta-senha
AUTH_TOKEN_SECRET=trocar-token-secret-grande
AUTH_TOKEN_TTL_HOURS=12

# Integracao SQL Server 2014 -> KDS (somente leitura no SQL)
# SQL2014_HOST=127.0.0.1
# SQL2014_PORT=1433
# SQL2014_USER=usuario_leitura
# SQL2014_PASSWORD=senha
# SQL2014_DATABASE=nome_banco
# SQL2014_ENCRYPT=false
# SQL2014_TRUST_CERT=true
# SQL2014_POLL_INTERVAL_MS=3000
# SQL2014_INITIAL_SYNC_AT=1970-01-01T00:00:00.000Z
# SQL2014_STATE_FILE=.sql2014-bridge-state.json
# SQL2014_QUERY_FILE=./sql2014-example-query.sql
# SQL2014_STATUS_MODE=parity
# SQL2014_STATUS_MAP=
#
# Alternativa ao arquivo: definir SQL2014_QUERY direto no .env (query em uma unica linha)
# SQL2014_QUERY=SELECT ...
#
# Endereco da API KDS e autenticacao para envio dos pedidos
# KDS_API_BASE=http://127.0.0.1:8081
# KDS_AUTH_USERNAME=cliente
# KDS_AUTH_PASSWORD=trocar-esta-senha
# KDS_AUTH_TOKEN=
#
# Impressao automatica de senha de pedido
# PRINT_PEDIDO_AUTO_ENABLED=false
# PRINT_PEDIDO_MODO=IMPRESSORA
# PRINT_PEDIDO_IMPRESSORA=Nome Exato da Impressora no Windows
# PRINT_PEDIDO_OUTPUT_DIR=C:\\FlowKDS\\Impressoes
# Atlas (exemplo):
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/kds?retryWrites=true&w=majority&appName=KDS
